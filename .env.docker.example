# IVS — Docker uchun muhit o'zgaruvchilari. Nusxa oling:  cp .env.docker.example .env  va qiymatlarni to'ldiring.
# .env git'ga tushmaydi va image ichiga kirmaydi (faqat konteyner ishga tushganda beriladi).

# ───────── Asosiy ─────────
SECRET_KEY=                      # uzun tasodifiy qator: python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=0
# Healthcheck uchun "localhost" ham bo'lishi shart
ALLOWED_HOSTS=report.example.uz,localhost
CSRF_TRUSTED_ORIGINS=https://report.example.uz
CORS_ALLOWED_ORIGINS=https://report.example.uz
SITE_BASE_URL=https://report.example.uz
# HTTP orqali sinash uchun (masalan, http://localhost) 0 qiling; productionda 1 (standart) qoldiring
# HTTPS_ONLY=0
# nginx tashqaridan eshitadigan port (standart 80)
# HTTP_PORT=80

# ───────── Ma'lumotlar bazasi (compose'dagi db servisi) ─────────
POSTGRES_DB=ivs
POSTGRES_USER=ivs
POSTGRES_PASSWORD=

# ───────── SSO / E-IMZO ─────────
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTH_URL=
SSO_TOKEN_URL=
SSO_REDIRECT_URI=https://report.example.uz/sso/callback/
SSO_EIMZO_SIGN_URL=
EIMZO_RETURN_URL=
# MOBILE_SSO_REDIRECT_URIS=
# EIMZO_PENDING_TTL=900
# EIMZO_REQUIRE_DOC=0

# ───────── Tashqi xizmatlar ─────────
GATEWAY_BASE_URL=
GATEWAY_USERNAME=
GATEWAY_PASSWORD=
TELEGRAM_BOT_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST=
# ZOOM_TIMEZONE=Asia/Tashkent
# ZOOM_WAITING_ROOM=1
# MEETING_BUFFER_MINUTES=

# ───────── PDF ─────────
PDF_ENGINE=weasyprint

# ───────── Brauzer push (VAPID) ─────────
# Maxfiy kalit fayli: standart ./private_key.pem (konteynerga faqat o'qish uchun ulanadi). Boshqa joyda bo'lsa yo'lini bering.
# VAPID_PRIVATE_KEY_PATH=./private_key.pem
# VAPID_PUBLIC_KEY=

# ───────── Android (FCM) va boshqalar ─────────
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json   # faylni volume/secret orqali ulang
# ANDROID_LATEST_VERSION=
# ANDROID_MIN_VERSION=
# ANDROID_UPDATE_URL=
# ANDROID_UPDATE_MESSAGE=
# API_MAINTENANCE=0
# API_MAINTENANCE_MESSAGE=
# ANTHROPIC_API_KEY=
# SWAGGER_PUBLIC=0
# CONTEXT_CACHE_SECONDS=
